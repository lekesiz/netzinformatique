{
  "name": "netz-informatique-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:client && pnpm build:ssr && pnpm prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .prerender",
    "prerender": "node scripts/prerender.mjs",
    "test:budgets": "node scripts/check-budgets.mjs",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "quality:gate": "pnpm lint && pnpm test && pnpm audit:prod",
    "build:verified": "pnpm quality:gate && pnpm build && pnpm test:budgets",
    "optimize:images": "node scripts/optimize-images.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^10.74.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^25.10.10",
    "lucide-react": "^0.510.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3",
    "resend": "^6.28.0",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "terser": "^5.51.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af"
}
